[Unit]
Description=Benchpress website and API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=benchpress
Group=benchpress
Environment=BENCHPRESS_DB=/var/lib/benchpress/benchpress.db
Environment=BENCHPRESS_BIND=127.0.0.1:8080
Environment=BENCHPRESS_LOG_FORMAT=json
EnvironmentFile=/etc/benchpress/env
ExecStart=/usr/bin/litestream replicate -config /etc/benchpress/litestream.yml -exec /usr/local/bin/benchpress-server
Restart=on-failure
RestartSec=2
StateDirectory=benchpress
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/benchpress

[Install]
WantedBy=multi-user.target
